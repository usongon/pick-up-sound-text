{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiyane",
  "version": "0.1.0",
  "identifier": "com.usongon.shiyane",
  "build": {
    "beforeDevCommand": { "script": "npm install && npm run dev", "cwd": "src-ui" },
    "beforeBuildCommand": { "script": "npm install && npm run build", "cwd": "src-ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "./src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾言 - Shiyane",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
