{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiyane",
  "version": "0.1.0",
  "identifier": "com.usongon.shiyane",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "src-ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "src-ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "./src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾言 - Shiyane",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
